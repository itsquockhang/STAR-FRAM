# Use official GPU-optimized PyTorch image as base
FROM pytorch/pytorch:2.4.0-cuda12.1-cudnn9-runtime

# Install git and ffmpeg for audio extraction and transcription
RUN apt-get update && apt-get install -y --no-install-recommends git ffmpeg && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies.
# Since PyTorch is already pre-installed in this image, we install the other packages directly.
# This prevents downloading a new PyTorch package and saves gigabytes of download size.
# Kept in sync with pyproject.toml (minus the mlx/mlx-whisper extras, which are
# macOS-arm64-only and irrelevant to this CUDA image).
RUN pip install --no-cache-dir \
    "gliner2 @ git+https://github.com/fastino-ai/GLiNER2.git" \
    "bcrypt>=5.0.0" \
    "fastapi>=0.139.0" \
    "jinja2>=3.1.6" \
    "motor>=3.7.1" \
    "pyjwt>=2.13.0" \
    "python-dotenv>=1.2.2" \
    "python-multipart>=0.0.32" \
    "qdrant-client>=1.18.0" \
    "redis>=8.0.1" \
    "uvicorn[standard]>=0.51.0" \
    "tqdm" \
    "yt-dlp" \
    "faster-whisper" \
    "soundfile" \
    "trafilatura>=2.1.0" \
    "chonkie>=1.7.0" \
    "dspy" \
    "litellm<1.91.0"

# Copy the application code
COPY src/ ./src
COPY main.py ./

# Run the application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
